# ============================================================================
# Watch-to-Earn Offerwall Platform — Environment Variables
#
# Mazkur fayl barcha foydalaniladigan environment variable'larni ro'yxatlash
# uchun namunadir. HECH QACHON haqiqiy kalitlarni commit qilmang!
# .gitignore allaqachon .env* fayllarni istisno qiladi.
#
# Vercel dashboard'da set qilish uchun: Project > Settings > Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# [MAJBURIY] Supabase — client tomoni (NEXT_PUBLIC_ = brauzerga inlinelana  qilinadi)
# Supabase Dashboard > Project Settings > API dan oling.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ----------------------------------------------------------------------------
# [MAJBURIY] Supabase — server tomoni (Edge Function'lar uchun, SECRET! Brauzerga tushmaydi)
# Supabase Dashboard > Project Settings > API > service_role secret dan oling.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ----------------------------------------------------------------------------
# [MAJBURIY] Telegram Bot — Edge Function (telegram-auth) HMAC-SHA256 tekshiruvi uchun
# @BotFather dan olinadi. Supabase Edge Function secrets ga ham qo'shish kerak.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot_username

# ----------------------------------------------------------------------------
# [TAVSIYA] Backend API URL (fallback: https://api.fee.app)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.fee.app

# ----------------------------------------------------------------------------
# [ISHLATILADIGAN] CDN / Static resurslar
# ----------------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL=https://cdn.example.com

# ----------------------------------------------------------------------------
# [OPTIONAL] Monitoring / Analytics
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.us.sentry.io/xxxx
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# ----------------------------------------------------------------------------
# [OPTIONAL] Reklama (Ad) provayderlari SDK kalitlari
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~yyyyyyyyyy
NEXT_PUBLIC_UNITY_GAME_ID=your-unity-game-id
NEXT_PUBLIC_IRONSOURCE_APP_KEY=your-ironsource-key
NEXT_PUBLIC_APPLOVIN_SDK_KEY=your-applovin-sdk-key
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ----------------------------------------------------------------------------
# [OPTIONAL] Feature flag'lar / Runtime sozlamalar (default qiymatlar bilan)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_CRASH_REPORTING=true
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_FEATURE_FLAGS=true
NEXT_PUBLIC_ENABLE_REMOTE_CONFIG=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false
NEXT_PUBLIC_ENABLE_BACKGROUND_SYNC=true
NEXT_PUBLIC_MAX_RETRY_ATTEMPTS=3
NEXT_PUBLIC_REQUEST_TIMEOUT=30000

# ----------------------------------------------------------------------------
# [ISHLAB CHIQARISH] Vercel / Build env
# ----------------------------------------------------------------------------
# NODE_ENV ni Vercel o'zi Production/Preview/Development uchun o'rnatadi.
# DISABLE_HMR faqat local AI Studio uchun kerak (Vercel'da kerak emas).
